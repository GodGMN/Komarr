# Keep generated files and local credentials out of the build context.

# Build outputs / test artefacts (rebuilt inside the image)
_output/
_tests/
_smoke-config/

# Per-RID intermediate output left by `dotnet publish` runs
**/bin/
**/obj/

# Node modules (stage 2 reinstalls inside the node:24-alpine layer)
node_modules/

# Git history not needed by the build
.git/
.github/

# Coverage + test droppings
CoverageResults/
TestResult.xml
TestLog.txt
*.trx

# IDE / editor noise
.vscode/
.idea/
*.swp
.DS_Store

# Local config / secrets if any operator drops them in tree
*.env
*.local

# Local Runewire credentials and agent configuration
.mcp.json
.codex/
AGENTS.md

# Local Compose data
docker-config/
docker-manga/
docker-downloads/
